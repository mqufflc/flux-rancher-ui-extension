# Copy this file to dev/.env and fill in the values below.
# dev/.env is already covered by the repo's .gitignore (.env is ignored).

CLUSTER_NAME=flux-dev
RANCHER_CONTAINER_NAME=rancher-dev
RANCHER_VERSION=v2.10.0
RANCHER_HTTPS_PORT=8443
RANCHER_BOOTSTRAP_PASSWORD=admin-password123

# flux bootstrap github (existing repo)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PATH=clusters/flux-dev
GITHUB_BRANCH=main
